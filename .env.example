POSTGRES_DB=ai_house_generator

# Bootstrap account - Docker initialization only
POSTGRES_USER=ahg_app
POSTGRES_PASSWORD=CHANGE_ME


# Application runtime account
POSTGRES_RUNTIME_USER=ahg_runtime
POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME


# Dedicated migration account
POSTGRES_MIGRATOR_USER=ahg_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# CAD artifact storage (relative to services/api working directory)
CAD_STORAGE_ROOT=../../storage/cad
FREECAD_PYTHON=D:/freecad/bin/python.exe
